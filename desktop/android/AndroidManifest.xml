<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.windstation.weatheredkiwi">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Самообновление: новый APK ставится через PackageInstaller (MainActivity.installApk). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Уведомления (сводка ветра, тревоги). С Android 13 — по запросу. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Долгая тихая вибрация на полосе установки обновления (обычное разрешение, без запроса). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Weathered_Kiwi"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Окно приложения. Сам в списке приложений не виден: туда его выводят два
             ярлыка ниже — стеклянный и тональный значок, включён ровно один
             (тумблер «Liquid Glass иконка», MainActivity.setIcon). Стеклянный ярлык
             носит прежнее имя .MainActivity, чтобы значок на рабочем столе пережил
             обновление со старых версий. -->
        <activity
            android:name=".WindActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".WindActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".TonalLauncher"
            android:targetActivity=".WindActivity"
            android:icon="@mipmap/ic_tonal"
            android:roundIcon="@mipmap/ic_tonal"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Виджеты рабочего стола (WindWidget.java). Два входа в списке виджетов —
             квадратный и широкий; рисует их один и тот же код, и оба растягиваются. -->
        <receiver
            android:name=".WindWidget"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wk_widget_info" />
        </receiver>
        <receiver
            android:name=".WindWidget$Wide"
            android:label="@string/widget_wide_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wk_widget_wide_info" />
        </receiver>
    </application>
</manifest>
