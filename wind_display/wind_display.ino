// ===== TOUCH CALIBRATION =====
void runTouchCalibration() {
  lcd.fillScreen(C_BG);
  lcd.setFont(&fTextB.font);
  lcd.setTextColor(C_TEXT);
  lcd.setTextDatum(textdatum_t::middle_center);
  lcd.drawString("Калибровка касания", W / 2, 100);
  lcd.setFont(&fText.font);
  lcd.drawString("коснись меток в углах по очереди", W / 2, 124);
  delay(1500);
  lcd.calibrateTouch(touchCal, 0xFFFFFFu, 0x000000u, 16);
  Serial.println("\n=== Touch calibration: paste over touchCal in wind_display.ino ===");
  Serial.print("uint16_t touchCal[8] = {");
  for (int i = 0; i < 8; i++) Serial.printf("%u%s", touchCal[i], i < 7 ? ", " : "};\n");
  Serial.println("...and set TOUCH_CAL_VALID to true.");
}

// ===== DEMO =====
#if DEMO_WITHOUT_STATION
void demoFrame() {
  static unsigned long last = 0;
  if (millis() - last < 200 || (lastFrameMs && millis() - lastFrameMs < 5000 && framesOk > 0 && linkBytes > 0)) return;
  last = millis();
  float t = millis() / 1000.0f;
  st.speed = fmaxf(0, 6 + 4 * sinf(t / 7) + 2.5f * sinf(t * 1.7f));
  st.gust = fmaxf(st.gust * 0.999f, st.speed);
  st.batteryPresent = true; st.battery = 3.95f; st.batteryPercent = 78;
  strcpy(st.chargeState, "discharging"); strcpy(st.powerSource, "battery");
  st.hasPpp = true; strcpy(st.pppState, "online"); st.hasCloud = true; st.cloudConnected = true;
  st.uptime = millis() / 1000;
  lastFrameMs = millis();
}
#endif

// ===== SETUP =====
void setup() {
  // Before Serial.begin: the UART divisor comes from the CPU clock. 80 MHz is plenty for
  // a 5 Hz screen and roughly halves the CPU's share of the current. The radio is never
  // started (no WiFi.h, no BT), which is the other half.
  setCpuFrequencyMhz(80);
  Serial.begin(115200);
  Serial.println("\n=== Wind Display (CYD) ===");

  // The link. Only RX is assigned: the core falls back to its default UART2 pins only
  // when BOTH are negative, so tx = -1 leaves every other pin alone. A ring bigger than
  // a frame so a slow draw pass never costs characters.
  Serial2.setRxBufferSize(4096);
  Serial2.begin(LINK_BAUD, SERIAL_8N1, PIN_LINK_RX, -1);

  pinMode(PIN_WAKE_BTN, INPUT_PULLUP);
  pinMode(PIN_BOOT_BTN, INPUT_PULLUP);
  for (int p : {PIN_LED_R, PIN_LED_G, PIN_LED_B}) { pinMode(p, OUTPUT); digitalWrite(p, HIGH); }
  analogReadResolution(12);

  setenv("TZ", DISPLAY_TZ, 1);
  tzset();

  for (int i = 0; i < HIST_N; i++) { histAvg[i] = NAN; histMax[i] = NAN; }

  lcd.init();
  lcd.setRotation(DISPLAY_ROTATION);
  lcd.setBrightness(BL_MAX);
  if (!fText.load(FONT_TEXT) || !fTextB.load(FONT_TEXT_B) || !fMid.load(FONT_MID) || !fBig.load(FONT_BIG))
    Serial.println("Font load FAILED — regenerate display_fonts.h");

  if (digitalRead(PIN_BOOT_BTN) == LOW) runTouchCalibration();
  else if (TOUCH_CAL_VALID) lcd.setTouchCalibrate(touchCal);

  drawTestScreen();
  delay(2500);

  for (auto* s : {&sTop, &sHero, &sGraph, &sStat}) s->setColorDepth(16);
  bool ok = sTop.createSprite(W, TOP_H) && sHero.createSprite(W, HERO_H) &&
            sGraph.createSprite(W, GRAPH_H) && sStat.createSprite(W, STAT_H);
  Serial.printf("Sprites %s, heap free %lu, largest block %lu\n", ok ? "OK" : "PARTIAL (direct draw)",
                (unsigned long)ESP.getFreeHeap(), (unsigned long)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
  pushPageBg();
  lastActivity = millis();
  bucketStart = millis();
}

// ===== LOOP =====
int page = 0;                  // 0 = main, 1 = details
bool touchWasDown = false;
unsigned long lastDraw = 0, lastSlowDraw = 0, lastLdrLog = 0, lastBlService = 0;
unsigned long drawnFrameMs = 1;   // lastFrameMs the screen currently reflects

void loop() {
  pumpLines(Serial2, rdLink, true);
  pumpLines(Serial, rdUsb, false);
#if DEMO_WITHOUT_STATION
  demoFrame();
#endif
  historySample();

  // Input: a tap wakes a dark screen and does nothing else; on a lit screen it flips pages.
  int32_t tx, ty;
  bool down = lcd.getTouch(&tx, &ty) || digitalRead(PIN_WAKE_BTN) == LOW;
  if (down && !touchWasDown) {
    if (!blOn) backlightWake();
    else {
      backlightWake();
      page ^= 1;
      pageBg = page ? GLASS_BG_DETAILS : GLASS_BG_MAIN;
      pushPageBg();
      drawnFrameMs = 0;   // force a full redraw of the new page
    }
  }
  touchWasDown = down;

  if (dataFresh() && st.gust >= WAKE_ON_GUST_MS) backlightWake();

  if (millis() - lastBlService > 100) { serviceBacklight(); lastBlService = millis(); }

  // Draw on a new frame, and once a second regardless (clock, data age, staleness).
  bool newFrame = lastFrameMs != drawnFrameMs;
  bool slowTick = millis() - lastSlowDraw >= 1000;
  if (blOn && (newFrame || slowTick) && millis() - lastDraw >= 100) {
    lastDraw = millis();
    if (slowTick) lastSlowDraw = millis();
    drawTopBar();
    if (page == 0) {
      if (newFrame || slowTick) drawHero();
      if (slowTick) drawGraph();
      drawStatus();
    } else if (slowTick || drawnFrameMs == 0) {
      drawDetails();
    }
    drawnFrameMs = lastFrameMs;
  }

  if (millis() - lastLdrLog > 5000) {
    lastLdrLog = millis();
    Serial.printf("ldr=%d bl=%u%s  frames ok=%lu bad=%lu bytes=%lu\n", analogRead(PIN_LDR), blLevel,
                  blOn ? "" : " (off)", framesOk, framesBad, linkBytes);
  }
}
