# === Секреты ===
# Все пароли прошивки (точка доступа, OTA, домашние сети) живут здесь.
# В git лежит только шаблон esp32_wind_station/secrets.example.h.
# Без secrets.h скетч НЕ собирается — это намеренно, см. #error в .ino
esp32_wind_station/secrets.h
# На будущее: ключи облака для задачи 10 (endpoint, HMAC) класть сюда же
.env
.env.*
!.env.example

# === Артефакты сборки ===
# Arduino/ESP32 build (пересобирается arduino-cli, ~35 МБ).
# Два пути: --output-dir из CLAUDE.md кладёт в корневой build/, скетч-каталог — в свой
/build/
esp32_wind_station/build/
# Vite / npm
node_modules/
wind-ui/dist/
dist/

# === Большие снапшоты-архивы (пересобираются из исходников) ===
esp32_wind_station.zip
wind-ui.zip
# папка для заливки на хостинг — пересобирается из wind-ui/dist
mywindprobe-site.zip
# WindStation-kit.zip НЕ игнорируем: только в нём лежат tools/*.ps1 и SETUP.md
# Распакованные драйверы модема — восстанавливаются из drivers/A7600X-Windows-Driver.7z,
# а сам архив коммитится (см. CLAUDE.md, §Git)
drivers/a7600x/

# === Рабочие копии и черновики правок ===
*.bak
*.bak-*
*.orig
*.rej

# === Временное ===
temp/
tmp/
logs/
*.log

# === KiCad ===
*.kicad_prl
*.lck
~*
*-backups/
fp-info-cache
# local-history плагина KiCad/IDE — внутри свой .git, вложенным репозиторием в наш не берём
.history/
.mcp-backups/

# === IDE / OS ===
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# === Инструменты ===
.claude/settings.local.json
.remember/logs/
.remember/tmp/
